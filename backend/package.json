{
  "name": "backend",
  "version": "1.0.0",
  "description": "Coin Management System Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npx prisma generate --schema=prisma/schema.prisma",
    "postinstall": "npx prisma generate --schema=prisma/schema.prisma",
    "migrate": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "migrate:prod": "npx prisma migrate deploy --schema=prisma/schema.prisma",
    "generate": "npx prisma generate --schema=prisma/schema.prisma",
    "seed": "node ../prisma/seed.js",
    "studio": "npx prisma studio --schema=prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node ../prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.3.2",
    "fast-csv": "^5.0.8",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "prisma": "^6.19.3",
    "uuid": "^14.0.3"
  }
}
