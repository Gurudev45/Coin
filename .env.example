# ==============================================================================
# COIN MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `backend/.env` and update the values as needed.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# OPTION A — Free Cloud Database (Recommended: 0 install needed):
# Create a free database in 30 seconds at https://neon.tech or https://supabase.com
# DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# OPTION B — Local PostgreSQL / Docker:
# If running PostgreSQL locally or via `docker compose up -d`:
DATABASE_URL="postgresql://postgres:password@localhost:5432/coin_management"

# ------------------------------------------------------------------------------
# 2. JWT (JSON Web Token) SECURITY
# ------------------------------------------------------------------------------
# Secret key used to sign and verify authentication tokens
JWT_SECRET="coin-secret-jwt-key-2026-secure-random-token-change-in-prod"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. FRONTEND & MOBILE URLS (CORS)
# ------------------------------------------------------------------------------
# Web app URL
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. DEFAULT ADMIN CREDENTIALS (Used by `node ../prisma/seed.js`)
# ------------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@coinmanagement.com"
ADMIN_PASSWORD="Admin@123456"
